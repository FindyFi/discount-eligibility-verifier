# Copy to .env and fill in. Read by pm2 (ecosystem.config.cjs) via `node --env-file=.env`.
# Values referenced as ${NAME} in config/verifier.yaml come from here.

# Public HTTPS address of the service, as wallets and browsers reach it.
PUBLIC_URL=https://verifier.example.com

# API key of the demo-shop client in config/verifier.yaml (at least 16 characters).
DEMO_SHOP_API_KEY=change-me-to-a-long-random-secret

# Private JWK for signing results. Generate with: npm run -s keygen
# Keep the single quotes around the JSON.
RESULT_SIGNING_KEY=''

# For the openid_federation client ID prefix (federation section in the config).
# Generate each with: npm run -s keygen
# FEDERATION_KEY=''
# REQUEST_SIGNING_KEY=''

# For the decentralized_identifier client ID prefix (didWeb section in the config).
# DID_WEB_KEY=''

# Token for the wallet compatibility tester (compat section in the config).
# COMPAT_TOKEN=
